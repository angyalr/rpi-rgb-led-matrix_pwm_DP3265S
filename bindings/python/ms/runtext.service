[Unit]
Description=Pecsi Merlegstudio LED display
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/pi/rpi-rgb-led-matrix_pwm_experiment
Environment=MS_RUN_TEXT_CONFIG=/home/pi/runtext.ini
ExecStart=/home/pi/rpi-rgb-led-matrix_pwm_experiment/.venv/bin/python /home/pi/rpi-rgb-led-matrix_pwm_experiment/bindings/python/ms/runtext_launcher.py
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
